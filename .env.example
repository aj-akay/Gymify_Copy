# Supabase public values (safe for the browser; database RLS is required).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enable only after the backend database and inquiry review process are ready.
VITE_INQUIRY_API_ENABLED=false

# Leave blank for Vercel's same-origin API. Other static hosts need a hosted API URL.
VITE_API_BASE_URL=
